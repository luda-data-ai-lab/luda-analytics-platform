# Flask 설정
# 필수: 프로덕션(FLASK_ENV=production)에서는 반드시 임의의 긴 값을 지정해야 합니다.
# 예: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_ENV=development

# 개발 서버 설정 (프로덕션에서는 gunicorn 등 WSGI 서버 사용)
# FLASK_DEBUG=1 은 개발 환경에서만 사용하세요 (디버거를 통한 원격 코드 실행 위험)
# FLASK_DEBUG=0
# FLASK_RUN_HOST=127.0.0.1
# FLASK_RUN_PORT=5000

# HTTPS 배포 시 세션 쿠키를 Secure 로 강제 (production 에서는 기본 활성화)
# SESSION_COOKIE_SECURE=1

# 데이터베이스 설정
# 미설정 시 개발 환경에서는 SQLite(analytics.db)를 사용합니다.
# 프로덕션에서는 반드시 지정해야 합니다.
# DATABASE_URL=postgresql+psycopg2://username:password@localhost/analytics_db

# 계정 보안 설정
# 가입 가능한 회사 이메일 도메인 (쉼표 구분). 비우면 누구나 가입할 수 있습니다.
# REGISTRATION_ALLOWED_DOMAINS=ludaresearch.org
# 가입 시 요구할 초대 코드 (비우면 코드 없이 가입)
# REGISTRATION_INVITE_CODE=
# 로그인 실패 임계치와 잠금 시간(분). 0 이면 잠금 비활성화
# LOGIN_MAX_FAILED_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=15

# 가입 승인 설정
# 가입 후 관리자 승인이 필요한지 여부 (기본 true). false 면 가입 즉시 로그인 가능
# REQUIRE_ADMIN_APPROVAL=true
# 관리자 이메일 목록 (쉼표 구분). 이 계정들은 가입 시 자동 승인되며 승인 관리 화면을 사용할 수 있습니다.
# ADMIN_EMAILS=admin@ludaresearch.org,ops@ludaresearch.org

# AWS 설정 (배포시 필요)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-northeast-2

# GCP 설정 (배포시 필요)
# GCP_PROJECT_ID=your-project-id
# GCP_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json
